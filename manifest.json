{
    "manifest_version": 3,
    "name": "Catan Tracker",
    "version": "1.0",
    "description": "Track player resources",
    "content_scripts": [
        {
            "matches": ["https://colonist.io/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "permissions": ["storage"],
    "web_accessible_resources": [
        {
            "resources": ["page-bridge.js"],
            "matches": ["https://colonist.io/*"]
        }
    ]
}